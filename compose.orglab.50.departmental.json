{
  "services": {
    "docs": {
      "image": "python:3.12-slim",
      "working_dir": "/app",
      "volumes": [
        "./orglab:/app:ro"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 64,
      "mem_limit": "128m",
      "cpus": "0.20",
      "tmpfs": [
        "/tmp:size=16m"
      ],
      "command": [
        "python",
        "-u",
        "runtime.py",
        "service",
        "--name",
        "docs"
      ],
      "networks": [
        "services_internal"
      ]
    },
