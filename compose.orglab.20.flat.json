      ],
      "networks": [
        "employees_internal"
      ],
      "user": "${ORG_UID:?set_ORG_UID}:${ORG_GID:?set_ORG_GID}",
      "profiles": [
        "experiment"
      ],
      "environment": {
        "ORG_RUN_ID": "${ORG_RUN_ID:?set_ORG_RUN_ID}",
        "ORG_NODES": "20",
        "ORG_ROUNDS": "${ORG_ROUNDS:-3}",
        "ORG_TEST_ROUNDS": "${ORG_TEST_ROUNDS:-3}",
        "ORG_SEED": "${ORG_SEED:-20261114}",
        "ORG_STEP_SECONDS": "${ORG_STEP_SECONDS:-0.6}",
        "ORG_TOPOLOGY": "flat"
      }
    },
    "capture": {
      "build": {
        "context": ".",
        "dockerfile": "orglab/Dockerfile.capture"
      },
      "command": [
        "tcpdump",
        "-Z",
        "root",
        "-i",
        "any",
        "-p",
        "-nn",
        "-s",
        "0",
        "-U",
        "-w",
        "/captures/orglab.pcap",
        "tcp",
        "port",
        "8080"
      ],
      "network_mode": "service:gateway",
      "depends_on": [
        "gateway"
      ],
      "volumes": [
        "./outputs/orglab/${ORG_RUN_ID:?set_ORG_RUN_ID}/captures:/captures"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 32,
      "mem_limit": "96m",
      "cpus": "0.20",
      "tmpfs": [
        "/tmp:size=16m"
      ],
      "user": "0:0",
      "profiles": [
        "capture"
      ]
    }
